{
  "schema_version": 1,
  "host": "127.0.0.1",
  "port": 8765,
  "data_dir": "~/.local/share/localpilot-service",
  "clients": [
    {"subject": "codex", "token_env": "LOCALPILOT_CODEX_TOKEN", "routes": {"localpilot": "local"}},
    {"subject": "dsh", "token_env": "LOCALPILOT_DSH_TOKEN", "routes": {"localpilot": "local"}},
    {"subject": "companion", "token_env": "LOCALPILOT_COMPANION_TOKEN", "routes": {"localpilot": "local"}},
    {"subject": "operator", "token_env": "LOCALPILOT_OPERATOR_TOKEN", "operator": true,
      "scopes": ["read", "control", "cancel"], "approval_for": ["codex", "dsh", "companion"], "routes": {"localpilot": "local"}}
  ],
  "routes": {
    "local": {
      "workspace": "/absolute/path/to/task-workspace",
      "backend": {"kind": "local-openai", "base_url": "http://127.0.0.1:1234/v1", "model": "EXACT_HOST_CONFIGURED_MODEL_ID", "context_budget": 131072,
        "capabilities": {"tool_calling": true, "streaming": true}},
      "permissions": "approve-mutations",
      "capabilities": {"read": true, "write": true, "execute": false},
      "cloud_egress": "LOCAL_ONLY",
      "budgets": {"max_steps": 16, "max_tool_calls": 24, "max_output_tokens": 2048, "max_token_units": 1048576}
    }
  }
}
