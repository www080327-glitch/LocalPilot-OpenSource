+_TIMESTAMP_RE = re.compile(
+    r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}"
+    r"(?:Z|[+-][0-9]{2}:[0-9]{2})"
+)
+_VALUE_RE = re.compile(r"[+-]?[0-9]+(?:\.[0-9]{1,2})?")
