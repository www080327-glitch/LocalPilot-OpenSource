+def _bare_quote_record_ends(text: str) -> set[int]:
+    """Find CSV records containing a quote inside an unquoted field.
+
+    ``csv.reader(strict=True)`` rejects unmatched quotes and text after a closing
+    quote, but accepts a quote embedded in an unquoted field as ordinary text.
+    Such a quote is malformed CSV, so track quoting boundaries for this case.
+    """
+    bad_ends: set[int] = set()
+    in_quotes = False
+    field_start = True
+    bad_record = False
+    line = 1
+    index = 0
+
+    while index < len(text):
+        char = text[index]
+        if in_quotes:
+            if char == '"':
+                if index + 1 < len(text) and text[index + 1] == '"':
+                    index += 2
+                    continue
+                in_quotes = False
+            if char in "\r\n":
+                if char == "\r" and index + 1 < len(text) and text[index + 1] == "\n":
+                    index += 1
+                line += 1
+        elif char in "\r\n":
+            if bad_record:
+                bad_ends.add(line)
+            bad_record = False
+            field_start = True
+            if char == "\\r" and index + 1 < len(text) and text[index + 1] == "\\n":
+                index += 1
+            line += 1
+        elif char == ",":
+            field_start = True
+        elif char == '"':
+            if field_start:
+                in_quotes = True
+            else:
+                bad_record = True
+        else:
+            field_start = False
+        index += 1
+
+    if bad_record:
+        bad_ends.add(line)
+    return bad_ends
