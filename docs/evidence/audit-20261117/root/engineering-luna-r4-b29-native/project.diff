+                timestamp_text[:-1] + "+00:00" if timestamp_text.endswith("Z") else timestamp_text
+            ).astimezone(timezone.utc)
+        except ValueError as exc:
+            raise ValueError(f"row {line}: invalid timestamp") from exc
